          "name": "Heartbeat de cámara",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha actual con zona horaria de Colombia (el contrato la exige con offset).",
                  "const d = new Date(Date.now() - 5 * 3600 * 1000);",
                  "pm.collectionVariables.set(\"fecha_ahora\", d.toISOString().slice(0, 19) + \"-05:00\");",
                  "const fin = new Date(Date.now() - 5 * 3600 * 1000 + 24 * 3600 * 1000);",
                  "pm.collectionVariables.set(\"fecha_manana\", fin.toISOString().slice(0, 19) + \"-05:00\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agente/camaras/{{camara_id}}/heartbeat",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "agente",
                "camaras",
                "{{camara_id}}",
                "heartbeat"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_agente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
